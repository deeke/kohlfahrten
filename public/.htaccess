# BoßelStrecken – Schutz sensibler Dateien
Options -Indexes
DirectoryIndex index.html

<FilesMatch "^(config\.php|config\.sample\.php|.*\.sql|.*\.md|\.env.*|composer\.(json|lock))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 /\.git

# Browser-Cache: Dateien mit ?v=... dürfen lange gecacht werden
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# HTTPS erzwingen (erst aktivieren, wenn SSL bei Strato eingeschaltet ist: # entfernen)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
